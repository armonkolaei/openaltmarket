{
  "name": "openaltmarket",
  "version": "0.1.0",
  "description": "OpenAltMarket starter application",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,api \"npm:dev:frontend\" \"npm:dev:api\"",
    "dev:frontend": "vite",
    "dev:frontend:fixed": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "dev:e2e": "concurrently -k -n frontend,api \"npm:dev:frontend:fixed\" \"npm:dev:api\"",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "dev:vercel": "npx vercel dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armonkolaei/openaltmarket.git"
  },
  "keywords": [
    "vue",
    "vite",
    "vercel",
    "firebase",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/armonkolaei/openaltmarket/issues"
  },
  "homepage": "https://github.com/armonkolaei/openaltmarket#readme",
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "mongodb": "^6.20.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@firebase/app": "0.16.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vercel/node": "^5.3.24",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.7",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.7",
    "vue-tsc": "^3.1.1"
  }
}
